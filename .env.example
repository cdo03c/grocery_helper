# ── AnyList credentials ──────────────────────────────────────────────────────
ANYLIST_EMAIL=your@email.com
ANYLIST_PASSWORD=your_password

# ── Store settings ────────────────────────────────────────────────────────────
DEFAULT_STORE_ZIP=12345
# Comma-separated default stores in Allowed Stores (leave blank for all)
DEFAULT_ALLOWED_STORES=
# Optional default max store stops (leave blank for unlimited)
DEFAULT_MAX_STORES=
ADVERTISED_ONLY=false
UI_SETTINGS_FILE=~/.config/grocery_helper/ui_settings.json

# ── Cache ─────────────────────────────────────────────────────────────────────
PRICE_CACHE_TTL_SECONDS=3600

# ── Kroger Developer API (Optional live data) ─────────────────────────────────
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# ── Weekly Flyer Sources (Market Basket, Whole Foods & Flipp) ───────────────
WHOLE_FOODS_STORE_ID=10010
WHOLE_FOODS_PRIME=true
ENABLE_LIVE_FLYERS=false
ENABLE_FLIPP=true

# ── Crowdsourced Retail Shelf Prices (Open Prices) ───────────────────────────
ENABLE_OPEN_PRICES=false

# ── App ───────────────────────────────────────────────────────────────────────
APP_TITLE="Grocery Helper"
DEBUG=false
