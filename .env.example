# ── AnyList credentials ──────────────────────────────────────────────────────
ANYLIST_EMAIL=your@email.com
ANYLIST_PASSWORD=your_password

# ── Store settings ────────────────────────────────────────────────────────────
DEFAULT_STORE_ZIP=12345

# ── Cache ─────────────────────────────────────────────────────────────────────
PRICE_CACHE_TTL_SECONDS=3600

# ── Kroger Developer API (Optional live data) ─────────────────────────────────
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
APP_TITLE="Grocery Helper"
DEBUG=false
